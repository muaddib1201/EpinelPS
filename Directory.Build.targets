<Project>
  <Target Name="NikkeRequireIsolatedBuild" BeforeTargets="PrepareForBuild"
          Condition="'$(NikkeAllowPrimaryBuild)' != 'true'">
    <Error Condition="!$([System.IO.File]::Exists('$(MSBuildThisFileDirectory).git'))"
           Text="NIKKE: build in your registered session worktree. Run D:\Claude Lab\NIKKE\.tools\collaboration\Start-Session.ps1 first; the shared checkout is a reference copy." />
  </Target>
</Project>
