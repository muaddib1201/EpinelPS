@model EpinelPS.Models.Admin.ManagedNpcAdminModel
@using System.Globalization
@using EpinelPS.Services
@{
    ViewData["Title"] = "托管 NPC";
    string Time(DateTime value) => value == default ? "—" : value.ToUniversalTime().AddHours(8).ToString("MM-dd HH:mm");
    int today = int.Parse(DateTime.UtcNow.AddHours(-EpinelPS.Database.JsonDb.Instance.ResetHourUtcTime).ToString("yyyyMMdd"));
}
<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h2>托管 NPC</h2><p class="text-muted mb-0">@Model.Players.Count 位指挥官 · 独立进度，持续成长 · 时间为北京时间</p></div>
        <a href="/admin/ManagedNpcs" class="btn btn-outline-secondary">刷新状态</a>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-lg-6"><div class="card h-100"><div class="card-body">
            <h5>托管设置</h5>
            <form action="/admin/ManagedNpcs/Configure" method="post" class="d-flex flex-wrap gap-3 align-items-end">
                @Html.AntiForgeryToken()
                <div><label class="form-label" for="globalEnabled">托管状态</label><select id="globalEnabled" name="Enabled" class="form-select"><option value="true" selected="@(Model.Settings.Enabled)">运行</option><option value="false" selected="@(!Model.Settings.Enabled)">暂停</option></select></div>
                <input name="Speed" type="hidden" value="1" />
                <div class="align-self-center">每天一轮 · 五阶段 · 三十分钟</div>
                <button class="btn btn-primary" type="submit">保存设置</button>
            </form><small class="text-muted">每六分钟执行一个阶段，资源收益与消耗实际结算。每日任务点数计入联盟，每人每日最多贡献 100 点；重启接续进度，已完成阶段不重复执行。</small>
        </div></div></div>
        <div class="col-lg-6"><div class="card h-100"><div class="card-body">
            <h5>@(Model.Players.Count == 0 ? "生成首批 NPC" : "增加 NPC")</h5>
            <form action="/admin/ManagedNpcs/Create" method="post" class="d-flex gap-3 align-items-end">
                @Html.AntiForgeryToken()<input type="hidden" name="RequestId" value="@Model.RequestId" />
                <div><label class="form-label" for="count">新增数量（总数上限 200）</label><input id="count" name="Count" type="number" min="1" max="@(Math.Max(1, 200-Model.Players.Count))" value="@(Math.Min(30,Math.Max(1,200-Model.Players.Count)))" class="form-control" /></div>
                <button class="btn btn-success" type="submit" disabled="@(Model.Players.Count >= 200)">生成玩家</button>
            </form><small class="text-muted">首次默认生成 30 名积极养成 NPC 和 5 个开放联盟；已有玩家的进度会继续保留。</small>
        </div></div></div>
    </div>
    <div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead><tr><th>指挥官</th><th>进度与主力</th><th>活动时间</th><th>托管与联盟</th><th>最近活动</th></tr></thead>
        <tbody>
        @foreach (var player in Model.Players)
        {
            var npc = player.ManagedNpc!;
            var stage = GameData.Instance.StageDataRecords.GetValueOrDefault(player.LastNormalStageCleared);
            var main = player.Characters.Where(c => player.RepresentationTeamDataNew.Contains(c.Csn)).ToArray();
            var mainSkills = main.SelectMany(c => new[] { c.Skill1Lvl, c.Skill2Lvl, c.UltimateLevel }).DefaultIfEmpty(1).ToArray();
            <tr>
                <td><strong>@npc.Name</strong><div class="small text-muted">NPC · @player.ID</div><div class="small mt-1" style="max-width:240px">@player.Description</div><div class="small">@(npc.Enabled && Model.Settings.Enabled ? "运行中" : "已暂停")</div></td>
                <td>
                    指挥官 Lv.@player.userPointData.UserLevel
                    <div class="small">普通主线第 @(stage?.ChapterId ?? 0) 章</div>
                    <div class="small text-muted">角色 @player.Characters.Count · SSR @ManagedNpcRoster.SsrCount(player) · 主力 Lv.@(main.Select(c=>ManagedNpcGrowth.Level(player,c)).DefaultIfEmpty().Min())</div>
                    <div class="small">@(player.SynchroDeviceUpgraded ? "增强同步器" : "同步器") Lv.@ManagedNpcGrowth.SynchroLevel(player) · 主力核心 +@(main.Select(c=>Math.Max(0,c.Grade-3)).DefaultIfEmpty().Max())</div>
                    <div class="small">养成第 @(npc.RosterTier+1) 档 · @(ManagedNpcRoster.TierNames[Math.Clamp(npc.RosterTier,0,4)]) · 技能 @(mainSkills.Min())～@(mainSkills.Max())</div>
                    <div class="small">全 SSR 主力 · @npc.BurstCycleSeconds 秒爆裂接续</div>
                    @if (npc.TeamSynergies.Count > 0)
                    {
                        <details class="small text-muted">
                            <summary>技能配合</summary>
                            @foreach (var synergy in npc.TeamSynergies)
                            {
                                <div>@synergy</div>
                            }
                        </details>
                    }
                    <div class="small text-muted">今日推图 @npc.StagesToday / @ManagedNpcService.DailyStageLimit</div>
                    <div class="small">@(npc.DailyRoutine?.Day == today ? $"今日阶段 {npc.DailyRoutine.CompletedPhases}/5" : "等待今日日程")</div>
                    <div class="small text-muted">每日任务 @player.ResetableData.DailyMissionPoints 点 · 今日联盟贡献 @(player.Guild.ActivityByDay?.GetValueOrDefault(today) ?? 0)</div>
                </td>
                <td class="small">上次：@Time(npc.LastActionUtc)<br />下次：@(npc.Enabled && Model.Settings.Enabled ? Time(npc.NextActionUtc) : "暂停中")</td>
                <td>
                    <form action="/admin/ManagedNpcs/Update" method="post" class="d-flex flex-wrap gap-1" style="max-width:340px">
                        @Html.AntiForgeryToken()<input type="hidden" name="Id" value="@player.ID" />
                        <select aria-label="@npc.Name 的托管状态" name="Enabled" class="form-select form-select-sm" style="width:85px"><option value="true" selected="@(npc.Enabled)">运行</option><option value="false" selected="@(!npc.Enabled)">暂停</option></select>
                        <input type="hidden" name="Tier" value="2" /><span class="badge text-bg-success align-self-center">积极养成 · 练度第 @(npc.RosterTier+1) 档</span>
                        <select aria-label="@npc.Name 的联盟" name="GuildId" class="form-select form-select-sm" style="width:210px"><option value="" selected="@(player.Guild.guildId==null)">未加入联盟</option>@foreach(var guild in Model.Guilds){<option value="@guild.Key" selected="@(player.Guild.guildId==guild.Key)">@guild.Value @(player.Guild.guildId==guild.Key && player.Guild.MemberType==1 ? "（会长）" : "")</option>}</select>
                        <button class="btn btn-sm btn-outline-primary" type="submit">保存</button>
                    </form>
                </td>
                <td class="small" style="min-width:210px"><details><summary>@(npc.Actions.FirstOrDefault()?.Text ?? "等待下一次活动")</summary>@foreach(var action in npc.Actions){<div class="border-top py-1"><span class="text-muted">@Time(action.AtUtc)</span> @action.Text</div>}</details></td>
            </tr>
        }
        </tbody>
    </table></div></div>
</div>
