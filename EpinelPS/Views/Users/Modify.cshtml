@model EpinelPS.Models.Admin.ModUserModel

@{
    ViewData["Title"] = "修改用户";
}

<div class="adminui-dashboard">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-4 mb-0" data-i18n="users.modify.title">修改用户信息</h1>
        <a asp-action="Index" class="btn btn-outline-light">
            <i class="fas fa-arrow-left me-2"></i> <span data-i18n="users.modify.backToList">返回列表</span>
        </a>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h3 class="mb-0" data-i18n="users.modify.subtitle">用户信息</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Modify">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Username" class="form-label" data-i18n="users.table.username">用户名</label>
                                    <input asp-for="Username" class="form-control" />
                                    <span asp-validation-for="Username" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Nickname" class="form-label" data-i18n="users.table.nickname">昵称</label>
                                    <input asp-for="Nickname" class="form-control" />
                                    <span asp-validation-for="Nickname" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <div class="adminui-checkbox-group">
                                    <div class="adminui-checkbox mb-2">
                                        <input asp-for="IsAdmin" class="adminui-checkbox-input" />
                                        <label asp-for="IsAdmin" class="adminui-checkbox-label" data-i18n="users.modify.isAdmin">管理员权限</label>
                                        <span asp-validation-for="IsAdmin" class="text-danger"></span>
                                    </div>

                                    <div class="adminui-checkbox">
                                        <input asp-for="IsBanned" class="adminui-checkbox-input" />
                                        <label asp-for="IsBanned" class="adminui-checkbox-label" data-i18n="users.modify.isBanned">禁止登录</label>
                                        <span asp-validation-for="IsBanned" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="form-label mb-0" data-i18n="users.modify.gachaRates">自定义抽卡概率 (%)</label>
                                    <button type="button" class="btn btn-sm btn-outline-light" onclick="clearGachaRates()" data-i18n="users.modify.gachaRatesClear">清空（使用官方概率）</button>
                                </div>
                                <div class="row g-2">
                                    <div class="col-4">
                                        <div class="input-group">
                                            <span class="input-group-text">SSR</span>
                                            <input asp-for="GachaRateSsr" type="number" step="0.01" min="0" max="100" class="form-control gacha-rate-input" />
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="input-group">
                                            <span class="input-group-text">SR</span>
                                            <input asp-for="GachaRateSr" type="number" step="0.01" min="0" max="100" class="form-control gacha-rate-input" />
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="input-group">
                                            <span class="input-group-text">R</span>
                                            <input asp-for="GachaRateR" type="number" step="0.01" min="0" max="100" class="form-control gacha-rate-input" />
                                        </div>
                                    </div>
                                </div>
                                <small id="gachaRateSum" class="d-block mt-2"></small>
                                <small class="d-block mt-1 gacha-rate-hint" data-i18n="users.modify.gachaRatesHint">全部留空 = 使用官方概率；填写时三项之和须为 100。官方常驻池参考：SSR 4 / SR 43 / R 53</small>
                            </div>
                        </div>

                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-primary" data-i18n="common.save">
                                <i class="fas fa-save me-2"></i> 保存
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h3 class="mb-0" data-i18n="users.modify.cheats">作弊功能</h3>
                </div>
                <div class="card-body">
                    <div class="cheats-section mb-4">
                        <h4 class="section-title" data-i18n="users.modify.campaign">战役</h4>
                        <div class="button-group">
                            <button class="btn btn-accent" onclick="runSimpleCmdWithPr('complete-stage', '@Model.ID', 'Enter chapter number and stage number (e.g. 1 2)')">
                                <i class="fas fa-forward me-2"></i> <span data-i18n="users.modify.skipStages">跳过关卡</span>
                            </button>
                            <button class="btn btn-accent" onclick="runSimpleCmd('complete-all-stages', '@Model.ID')">
                                <i class="fas fa-flag-checkered me-2"></i> <span data-i18n="users.modify.completeAllStages">完成所有主线关卡</span>
                            </button>
                            <button class="btn btn-accent" onclick="runSimpleCmd('complete-all-event-stages', '@Model.ID')">
                                <i class="fas fa-flag me-2"></i> <span data-i18n="users.modify.completeAllEventStages">完成所有活动关卡</span>
                            </button>
                            <button class="btn btn-danger" onclick="if (confirm(i18n.t('users.modify.unlockAllSubquestConfirm'))) runSimpleCmd('unlock-all-subquest-messages', '@Model.ID')">
                                <i class="fas fa-unlock-alt me-2"></i> <span data-i18n="users.modify.unlockAllSubquestMessages">Cheat：解锁所有支线对话</span>
                            </button>
                        </div>
                    </div>

                    <div class="cheats-section mb-4">
                        <h4 class="section-title" data-i18n="users.modify.characters">Characters:</h4>
                        <div class="button-group">
                            <button class="btn btn-accent" onclick="runSimpleCmd('add-all-characters', '@Model.ID')">
                                <i class="fas fa-users me-2"></i> <span data-i18n="users.modify.addAllChars">添加所有角色</span>
                            </button>
                            <button class="btn btn-accent" onclick="runSimpleCmd('add-all-costumes', '@Model.ID')">
                                <i class="fas fa-tshirt me-2"></i> <span data-i18n="users.modify.addAllCostumes">添加所有服装</span>
                            </button>
                            <button class="btn btn-accent" onclick="runSimpleCmd('add-all-collections', '@Model.ID')">
                                <i class="fas fa-gem me-2"></i> <span data-i18n="users.modify.addAllCollections">添加所有收藏品</span>
                            </button>
                            <button class="btn btn-accent" onclick="runSimpleCmdWithPr('add-character', '@Model.ID', 'Enter character ID. Wrong ID may cause game not to boot.')">
                                <i class="fas fa-user-plus me-2"></i> <span data-i18n="users.modify.addChar">添加角色</span>
                            </button>
                            <button class="btn btn-accent" onclick="runSimpleCmdWithPr('set-level', '@Model.ID', 'Enter level (1-999) to apply to all characters')">
                                <i class="fas fa-level-up-alt me-2"></i> <span data-i18n="users.modify.setCharLevels">设置角色等级</span>
                            </button>
                            <button class="btn btn-accent" onclick="runSimpleCmdWithPr('set-skill-level', '@Model.ID', 'Enter skill level (1-10) to apply to all characters')">
                                <i class="fas fa-bolt me-2"></i> <span data-i18n="users.modify.setSkillLevels">设置技能等级</span>
                            </button>
                            <button class="btn btn-accent" onclick="runSimpleCmdWithPr('set-core-level', '@Model.ID', 'core level / 0-3 sets stars')">
                                <i class="fas fa-star me-2"></i> <span data-i18n="users.modify.setCoreLevel">设置核心等级</span>
                            </button>
                            <button class="btn btn-accent" onclick="runSimpleCmdWithPr('set-all-bond-level', '@Model.ID', 'Enter bond level (1-30)')">
                                <i class="fas fa-heart me-2"></i> <span data-i18n="users.modify.setBondLevel">设置角色好感度</span>
                            </button>
                            <form asp-action="ResetCounsel" asp-route-id="@Model.ID" method="post" id="counselResetForm">
                                <button type="submit" class="btn btn-accent">
                                    <i class="fas fa-redo me-2"></i> <span data-i18n="users.modify.resetCounsel">重置咨询次数</span>
                                </button>
                            </form>
                            <form asp-controller="Liberate" asp-action="ResetLiberate" asp-route-id="@Model.ID" method="post" id="liberateResetForm">
                                <button type="submit" class="btn btn-accent">
                                    <i class="fas fa-redo me-2"></i> <span data-i18n="users.modify.resetLiberate">重置解放次数</span>
                                </button>
                            </form>
                        </div>
                        <small id="counselResetStatus" class="d-block mt-2" role="status"></small>
                        <small class="d-block mt-2 text-muted" data-i18n="users.modify.liberateResetHint">刷新当前解放对象的每日次数和任务，保留已累积点数与阶段。</small>
                        <small id="liberateResetStatus" class="d-block mt-2" role="status"></small>
                        <form asp-controller="Counsel" asp-action="Unlock" asp-route-id="@Model.ID" method="post"
                              id="counselUnlockForm" class="mt-3"
                              data-options-url="@Url.Action("Options", "Counsel", new { id = Model.ID })">
                            <h5 data-i18n="users.modify.counselUnlockTitle">解锁指定咨询</h5>
                            <p class="small text-muted" data-i18n="users.modify.counselUnlockHint">补入所选咨询的收集记录后，可在游戏的咨询日志中回看。</p>
                            <div class="row g-2">
                                <div class="col-sm-6">
                                    <label for="counselUnlockCharacter" class="form-label" data-i18n="users.modify.counselUnlockCharacter">角色</label>
                                    <select name="nameCode" id="counselUnlockCharacter" class="form-select" required disabled></select>
                                </div>
                                <div class="col-sm-6">
                                    <label for="counselUnlockEntry" class="form-label" data-i18n="users.modify.counselUnlockEntry">咨询序号</label>
                                    <select name="counselTid" id="counselUnlockEntry" class="form-select" required disabled></select>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-accent mt-2" disabled>
                                <i class="fas fa-unlock me-2"></i><span data-i18n="users.modify.counselUnlockButton">解锁所选咨询</span>
                            </button>
                            <small id="counselUnlockStatus" class="d-block mt-2" role="status"></small>
                        </form>
                    </div>

                    <div class="cheats-section mb-4">
                        <h4 class="section-title" data-i18n="users.modify.inventory">Inventory</h4>
                        <div class="button-group">
                            <button class="btn btn-accent" onclick="runSimpleCmdWithPr('add-all-materials', '@Model.ID', 'Enter material amount:')">
                                <i class="fas fa-tools me-2"></i> <span data-i18n="users.modify.addAllEquip">添加所有装备</span>
                            </button>
                            <button class="btn btn-accent" onclick="runSimpleCmdWithPr('add-item', '@Model.ID', 'Enter item ID and amount (e.g. 100 5)')">
                                <i class="fas fa-box-open me-2"></i> <span data-i18n="users.modify.addItem">添加物品</span>
                            </button>
                            <a asp-action="Currency" asp-route-id="@Model.ID">
                                <button class="btn btn-accent">
                                    <i class="fas fa-coins me-2"></i> <span data-i18n="users.modify.addCurrency">Add Currency</span>
                                </button>
                            </a>
                        </div>
                    </div>

                    <div class="cheats-section">
                        <h4 class="section-title" data-i18n="users.modify.misc">其他</h4>
                        <div class="button-group">
                            <button class="btn btn-accent" onclick="runSimpleCmd('finish-all-tutorials', '@Model.ID')">
                                <i class="fas fa-graduation-cap me-2"></i> <span data-i18n="users.modify.finishTutorials">完成所有教程</span>
                            </button>
                            <button class="btn btn-accent" onclick="runSimpleCmdWithPr('skip-tower', '@Model.ID', 'Skip tower floor for the selected user, towerid floor (Elysion=1, Misslis=2, Tetra=3, Pilgrim=4, Tribe=5) e.g 1 234')">
                                <i class="fas fa-building me-2"></i> <span>Skip Tower Floors</span>
                            </button>
                            <a asp-action="Messenger" asp-route-id="@Model.ID" class="btn btn-accent">
                                <i class="fas fa-comments me-2"></i> <span data-i18n="users.modify.messenger">Manage Messenger</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid mt-3">
        @if (!Model.OverloadedGear.Any())
        {
            <div class="alert alert-info">No overloaded gear found.</div>
        }
        else
        {
            <!-- Main form wrapping everything -->
            <form asp-action="ModifyGear" asp-route-id="@Model.ID" method="post" id="mainForm">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h1 class="mb-0">Modify Overload Gear</h1>
                    <div class="d-flex align-items-center gap-3">
                        <!-- Toggle for name display -->
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="nameDisplayToggle" />
                            <label class="form-check-label" for="nameDisplayToggle">
                                Show <span id="nameDisplayLabel">Name</span>
                            </label>
                        </div>
                        <button type="submit" name="submitType" value="saveAll" class="btn btn-info">Save All</button>
                    </div>
                </div>

                @foreach (var corp in Model.OverloadedGear
                                              .GroupBy(c => c.Manufacturer)
                                              .OrderBy(x => x.Key))
                {
                    <div class="col-lg-12 mb-4">
                        <div class="card">
                            <div class="card-header p-2" id="heading-@corp.Key">
                                <button class="btn btn-link w-100 d-flex justify-content-between align-items-center text-decoration-none border-0 shadow-none"
                                        type="button" data-bs-toggle="collapse" data-bs-target="#@corp.Key" aria-expanded="true"
                                        aria-controls="@corp.Key">
                                    <h3 class="mb-0">@(corp.Key == "OVERSPEC" ? "PILGRIM/OVERSPEC" : corp.Key)</h3>
                                    <i class="bi bi-chevron-down"></i>
                                </button>
                            </div>
                            <div id="@corp.Key" class="collapse show" aria-labelledby="heading-@corp.Key">
                                <div class="card-body">
                                    @foreach (var character in corp.OrderBy(c => c.CharacterName))
                                    {
                                        <div class="col-lg-12 mb-4">
                                            <div class="card">
                                                <div class="card-header bg-black">
                                                    <div class="d-flex align-items-center">
                                                        <div class="d-inline-flex mb-0 me-3 flex-grow-1">
                                                            <h2 class="mb-0 me-3 character-name"
                                                                data-name="@character.CharacterName"
                                                                data-character-tid="@character.CharacterTid"
                                                                data-toggle="tooltip"
                                                                title="@character.CharacterTid"
                                                                style="max-width:20ch;white-space: nowrap !important;
                                                                text-overflow: ellipsis !important;
                                                                overflow: hidden !important;">
                                                                @character.CharacterName
                                                            </h2>
                                                            <button type="submit" name="submitType"
                                                                    value="saveCharacter_@character.CharacterCsn"
                                                                    class="btn btn-info btn-sm" style="font-size:12pt;">
                                                                Save
                                                            </button>
                                                        </div>
                                                        <div class="d-flex align-items-stretch gap-1">
                                                            <h3 class="mb-0">LV@(character.CharacterLevel)</h3>
                                                            <div class="vr w opacity-75" style="width:2.5px;"></div>
                                                            <h3 class="mb-0">Skill 1: LV@(character.Skill1)</h3>
                                                            <div class="vr w opacity-75" style="width:2.5px;"></div>
                                                            <h3 class="mb-0">Skill 2: LV@(character.Skill2)</h3>
                                                            <div class="vr w opacity-75" style="width:2.5px;"></div>
                                                            <h3 class="mb-0">Burst Skill: LV@(character.BurstSkill)</h3>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card-body">
                                                    <div class="row g-3">
                                                        @foreach (var gear in character.Gears)
                                                        {
                                                            <div class="col-6 col-md">
                                                                <div class="card h-100 bg-dark">
                                                                    <div class="card-body d-flex flex-column">
                                                                        <!-- Hidden fields for identification -->
                                                                        <input type="hidden" name="GearUpdates[@gear.GearIsn].CharacterId" value="@character.CharacterCsn" />
                                                                        <input type="hidden" name="GearUpdates[@gear.GearIsn].GearId" value="@gear.GearIsn" />

                                                                        <h2 class="card-title mb-3">@gear.GearType</h2>

                                                                        <div class="mb-2">
                                                                            <label class="form-label mb-1 fw-bold fs-6">Level:</label>
                                                                            <input type="number"
                                                                                   class="form-control form-control-sm fw-bold fs-6"
                                                                                   name="GearUpdates[@gear.GearIsn].Level" value="@gear.GearLevel" min="0" max="5" />
                                                                        </div>

                                                                        <div class="mb-2">
                                                                            <label class="form-label mb-1 fw-bold fs-6">Option 1:</label>
                                                                            <select class="form-select form-select-sm fw-bold fs-6 p-2"
                                                                                    name="GearUpdates[@gear.GearIsn].Option1" asp-items="Model.GetOverloadSelectList(gear.Option1Id)">
                                                                                <option value="0">No Option</option>
                                                                            </select>
                                                                        </div>

                                                                        <div class="mb-2">
                                                                            <label class="form-label mb-1">Option 2:</label>
                                                                            <select class="form-select form-select-sm fw-bold fs-6 p-2"
                                                                                    name="GearUpdates[@gear.GearIsn].Option2" asp-items="Model.GetOverloadSelectList(gear.Option2Id)">
                                                                                <option value="0">No Option</option>
                                                                            </select>
                                                                        </div>

                                                                        <div class="mb-3">
                                                                            <label class="form-label mb-1">Option 3:</label>
                                                                            <select class="form-select form-select-sm fw-bold fs-6 p-2"
                                                                                    name="GearUpdates[@gear.GearIsn].Option3" asp-items="Model.GetOverloadSelectList(gear.Option3Id)">
                                                                                <option value="0">No Option</option>
                                                                            </select>
                                                                        </div>

                                                                        <button type="submit" name="submitType" value="updateGear_@gear.GearIsn" class="btn btn-primary w-100 mt-auto p-2">Update Gear</button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </form>
        }
    </div>
</div>

<style>
    /* adminui风格卡片标题 */
    .card-header {
        background-color: var(--adminui-primary);
        color: var(--adminui-light);
        font-weight: 600;
        letter-spacing: 1px;
        padding: 15px 20px;
    }

    .card-header h3 {
        margin: 0;
        font-size: 1.2rem;
    }

    /* 作弊功能部分 */
    .cheats-section {
        margin-bottom: 20px;
    }

    .section-title {
        color: var(--adminui-accent);
        font-size: 1.1rem;
        margin-bottom: 10px;
        font-weight: 600;
        letter-spacing: 1px;
        border-bottom: 1px solid var(--adminui-gray);
        padding-bottom: 8px;
    }

    .button-group {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    /* 自定义按钮 */
    .btn-accent {
        background-color: var(--adminui-accent-dark);
        color: white;
        border: none;
        transition: all var(--transition-fast);
    }

    .btn-accent:hover {
        background-color: var(--adminui-accent);
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(232, 62, 140, 0.4);
        color: white;
    }

    /* 自定义复选框样式 */
    .adminui-checkbox-group {
        margin-top: 10px;
    }

    .adminui-checkbox {
        display: flex;
        align-items: center;
        margin-bottom: 0;
    }

    .adminui-checkbox-input {
        position: absolute;
        opacity: 0;
        height: 0;
        width: 0;
    }

    .adminui-checkbox-label {
        position: relative;
        padding-left: 30px;
        cursor: pointer;
        user-select: none;
    }

    .adminui-checkbox-label:before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        width: 20px;
        height: 20px;
        background-color: var(--adminui-gray);
        border: 1px solid var(--adminui-gray-light);
        border-radius: var(--radius-sm);
        transition: all var(--transition-fast);
    }

    .adminui-checkbox-input:checked + .adminui-checkbox-label:before {
        background-color: var(--adminui-accent);
        border-color: var(--adminui-accent);
    }

    .adminui-checkbox-label:after {
        content: '\f00c';
        font-family: 'Font Awesome 5 Free', serif;
        font-weight: 900;
        position: absolute;
        left: 3px;
        top: 1px;
        color: white;
        opacity: 0;
        transition: opacity var(--transition-fast);
        font-size: 14px;
    }

    .adminui-checkbox-input:checked + .adminui-checkbox-label:after {
        opacity: 1;
    }

    /* 自定义抽卡概率 */
    .gacha-rate-hint {
        opacity: 0.7;
    }

    .gacha-rate-ok {
        color: var(--adminui-accent);
    }

    .gacha-rate-bad {
        color: #dc3545;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('counselUnlockForm');
        const character = document.getElementById('counselUnlockCharacter');
        const entry = document.getElementById('counselUnlockEntry');
        const button = form.querySelector('button');
        const status = document.getElementById('counselUnlockStatus');
        let version = 0;
        let busy = false;
        const t = (key, values) => i18n.t('users.modify.' + key, values);

        function updateButton() {
            button.disabled = busy || !entry.value || entry.selectedOptions[0]?.dataset.unlocked === 'true';
        }
        async function loadOptions(keepEntry) {
            const current = ++version;
            busy = true;
            button.disabled = true;
            entry.disabled = true;
            status.textContent = '';
            try {
                const url = new URL(form.dataset.optionsUrl, window.location.origin);
                if (character.value) url.searchParams.set('nameCode', character.value);
                url.searchParams.set('lang', i18n.currentLang || 'zh');
                const response = await fetch(url);
                if (!response.ok) throw new Error();
                const data = await response.json();
                if (current !== version) return;
                const selectedCharacter = character.value;
                character.replaceChildren();
                for (const item of data.characters) character.add(new Option(item.name, item.nameCode));
                if (selectedCharacter) character.value = selectedCharacter;
                character.disabled = !character.options.length;
                if (!selectedCharacter && character.value) return await loadOptions();
                entry.replaceChildren();
                for (const item of data.dialogues) {
                    const label = String(item.number).padStart(2, '0') + ' · ' +
                        t(item.unlocked ? 'counselUnlocked' : 'counselLocked');
                    const option = new Option(label, item.id);
                    option.dataset.unlocked = String(item.unlocked);
                    entry.add(option);
                }
                const preferred = keepEntry && data.dialogues.find(item => String(item.id) === String(keepEntry));
                entry.value = String((preferred || data.dialogues.find(item => !item.unlocked) || data.dialogues[0])?.id || '');
                entry.disabled = !entry.options.length;
                if (!character.options.length) status.textContent = t('counselUnlockEmpty');
            } catch {
                if (current === version) { entry.replaceChildren(); status.textContent = t('counselUnlockFailed'); }
            } finally {
                if (current === version) { busy = false; updateButton(); }
            }
        }
        character.addEventListener('change', () => loadOptions());
        entry.addEventListener('change', updateButton);
        form.addEventListener('submit', async event => {
            event.preventDefault();
            if (busy || button.disabled) return;
            const selected = entry.value;
            const body = new FormData(form);
            busy = true;
            button.disabled = true;
            character.disabled = true;
            entry.disabled = true;
            status.textContent = '';
            try {
                const response = await fetch(form.action, { method: 'POST', body });
                if (!response.ok) throw new Error();
                const result = await response.json();
                await loadOptions(selected);
                status.textContent = t('counselUnlockDone', { count: result.collected, total: result.total });
            } catch {
                status.textContent = t('counselUnlockFailed');
            } finally {
                busy = false;
                character.disabled = !character.options.length;
                entry.disabled = !entry.options.length;
                updateButton();
            }
        });
        window.addEventListener('adminui:i18n-ready', () => loadOptions(entry.value));
        window.addEventListener('adminui:languageChanged', () => loadOptions(entry.value));
        loadOptions();
    });

    document.getElementById('counselResetForm').addEventListener('submit', async function (event) {
        event.preventDefault();
        const button = this.querySelector('button');
        const status = document.getElementById('counselResetStatus');
        button.disabled = true;
        status.textContent = '';
        try {
            const response = await fetch(this.action, { method: 'POST', body: new FormData(this) });
            if (!response.ok) throw new Error();
            const { remaining } = await response.json();
            status.textContent = i18n.t('users.modify.counselResetDone', { count: remaining });
        } catch {
            status.textContent = i18n.t('users.modify.counselResetFailed');
        } finally {
            button.disabled = false;
        }
    });

    document.getElementById('liberateResetForm').addEventListener('submit', async function (event) {
        event.preventDefault();
        const button = this.querySelector('button');
        const status = document.getElementById('liberateResetStatus');
        button.disabled = true;
        status.textContent = '';
        try {
            const response = await fetch(this.action, { method: 'POST', body: new FormData(this) });
            const result = await response.json();
            if (!response.ok) {
                const key = result.error === 'no-active-liberation' ? 'liberateResetNoActive' :
                    result.error === 'liberation-completed' ? 'liberateResetCompleted' : 'liberateResetFailed';
                status.textContent = i18n.t('users.modify.' + key);
                return;
            }
            status.textContent = i18n.t('users.modify.liberateResetDone', { count: result.missionCount });
        } catch {
            status.textContent = i18n.t('users.modify.liberateResetFailed');
        } finally {
            button.disabled = false;
        }
    });

    function clearGachaRates() {
        document.querySelectorAll('.gacha-rate-input').forEach(i => i.value = '');
        updateGachaRateSum();
    }

    // Live total under the rate inputs: empty = official, otherwise must be 100
    function updateGachaRateSum() {
        const inputs = [...document.querySelectorAll('.gacha-rate-input')];
        const sumEl = document.getElementById('gachaRateSum');
        if (!sumEl) return;

        const filled = inputs.filter(i => i.value.trim() !== '');
        if (filled.length === 0) {
            sumEl.textContent = i18n.t('users.modify.gachaRatesOfficial');
            sumEl.className = 'd-block mt-2 gacha-rate-ok';
            return;
        }

        const sum = inputs.reduce((s, i) => s + (parseFloat(i.value) || 0), 0);
        const ok = filled.length === inputs.length && Math.abs(sum - 100) < 0.001;
        sumEl.textContent = i18n.t('users.modify.gachaRatesSum', { sum: Math.round(sum * 100) / 100 });
        sumEl.className = 'd-block mt-2 ' + (ok ? 'gacha-rate-ok' : 'gacha-rate-bad');
    }

    document.querySelectorAll('.gacha-rate-input').forEach(i => i.addEventListener('input', updateGachaRateSum));
    window.addEventListener('adminui:i18n-ready', updateGachaRateSum);
    window.addEventListener('adminui:languageChanged', updateGachaRateSum);

    document.addEventListener('DOMContentLoaded', function() {
        updateGachaRateSum();

        // Restore scroll position
        const savedScroll = localStorage.getItem('scrollPosition');
        if (savedScroll) {
            window.scrollTo(0, parseInt(savedScroll));
        }

        // --- Name display toggle ---
        const nameToggle = document.getElementById('nameDisplayToggle');
        const nameLabel = document.getElementById('nameDisplayLabel');
        const characterNames = document.querySelectorAll('.character-name');

        // Load saved preference (default: name)
        const showCharacterTid = localStorage.getItem('showCharacterTid') === 'true';
        nameToggle.checked = showCharacterTid;
        updateNameDisplay(showCharacterTid);

        nameToggle.addEventListener('change', function() {
            const showTid = this.checked;
            localStorage.setItem('showCharacterTid', showTid);
            updateNameDisplay(showTid);
        });

        function updateNameDisplay(showTid) {
            nameLabel.textContent = showTid ? 'TID' : 'Name';
            characterNames.forEach(el => {
                const name = el.getAttribute('data-name');
                const characterTid = el.getAttribute('data-character-tid');
                el.textContent = showTid ? characterTid : name;
                // Update tooltip title to the opposite value
                el.setAttribute('title', showTid ? name : characterTid);
            });
        }

        // --- Collapse state handling ---
        const collapsedCards = JSON.parse(localStorage.getItem('collapsedCards') || '{}');
        document.querySelectorAll('.collapse').forEach(collapse => {
            const collapseId = collapse.id;
            if (collapsedCards[collapseId] === true) {
                collapse.classList.remove('show');
            } else if (collapsedCards[collapseId] === false) {
                collapse.classList.add('show');
            }
        });

        let scrollTimeout;
        window.addEventListener('scroll', function() {
            clearTimeout(scrollTimeout);
            scrollTimeout = setTimeout(() => {
                localStorage.setItem('scrollPosition', window.scrollY);
            }, 100);
        });

        document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(button => {
            button.addEventListener('click', function() {
                const targetId = this.getAttribute('data-bs-target').replace('#', '');
                const targetCollapse = document.getElementById(targetId);

                setTimeout(() => {
                    const collapsedCards = JSON.parse(localStorage.getItem('collapsedCards') || '{}');
                    collapsedCards[targetId] = !targetCollapse.classList.contains('show');
                    localStorage.setItem('collapsedCards', JSON.stringify(collapsedCards));
                }, 100);
            });
        });

        document.querySelectorAll('form').forEach(form => {
            form.addEventListener('submit', function() {
                localStorage.setItem('scrollPosition', window.scrollY);
            });
        });
    });
</script>
