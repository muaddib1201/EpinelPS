@using EpinelPS.Data
@model List<int>
@{
    ViewData["Title"] = "Event configuration";
    var allBanners = GameData.Instance.LobbyPrivateBannerTable.Values.Reverse().ToList();
    var bannerNames = allBanners.ToDictionary(b => b.Id, EventBannerNameResolver.Resolve);
    var activeIds = Model;
}

<div class="adminui-dashboard">
    <form method="post" action="/admin/Events" id="eventForm">
        @* Top bar *@
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                    <a asp-action="Dashboard" asp-controller="Admin" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-arrow-left me-1"></i> <span data-i18n="events.backToList">Back</span>
                    </a>
                </div>
            <h1 class="display-4 mb-0" style="font-size: 1.8rem;" data-i18n="events.title">Event Configuration</h1>
            <div class="d-flex gap-2">
                <button type="submit" formaction="/admin/Events/ActivateLatest" class="btn btn-outline-success">
                    <i class="fas fa-bolt me-2"></i><span data-i18n="events.activateLatest">Activate Latest</span>
                </button>
                <button type="submit" class="btn btn-primary px-4">
                    <i class="fas fa-save me-2"></i><span data-i18n="events.save">Save Configuration</span>
                </button>
            </div>
        </div>

        @* Success message *@
        <div id="saveAlert" class="alert alert-success py-2" style="display: none;"></div>

        @* Active event tags *@
        <div class="card mb-4">
            <div class="card-body py-3">
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <strong class="me-2" style="min-width: 100px;"><span data-i18n="events.activeCount">Currently active</span> (<span id="activeCount">@activeIds.Count</span>)</strong>

                    <span id="activeTags" class="d-inline-flex flex-wrap gap-2">
                    @if (activeIds.Count > 0)
                    {
                        foreach (var id in activeIds)
                        {
                            var banner = allBanners.FirstOrDefault(b => b.Id == id);
                            if (banner == null) continue;
                            var name = bannerNames[banner.Id].English;
                            <span class="badge d-inline-flex align-items-center gap-1 active-tag" data-id="@id"
                                  style="background-color: var(--adminui-success); font-size: 0.85rem; padding: 0.3rem 0.6rem;">
                                <span class="active-tag-name">@name</span>
                                <i class="fas fa-times remove-tag" style="cursor: pointer; opacity: 0.7;" data-id="@id"></i>
                            </span>
                        }
                    }
                    </span>
                    <span id="noEventsSelected" class="text-muted small" data-i18n="events.noSelection"
                          style="display: @(activeIds.Count == 0 ? "" : "none");">None selected, will show latest event by default</span>
                </div>
            </div>
        </div>

        @* Events table with pagination *@
        <div class="card" style="margin-bottom: 80px;">
            <div class="card-header d-flex justify-content-between align-items-center py-2">
                <h5 class="mb-0"><i class="fas fa-list me-2"></i><span data-i18n="events.allEvents">All Events</span></h5>
                <div class="d-flex gap-2 align-items-center">
                    <span style="color: #aaa; font-size: 0.85rem;">
                        <span data-i18n="events.perPage">Per page</span>
                        <select id="pageSizeSelect" style="background: #2d2d2f; color: #ccc; border: 1px solid #444; border-radius: 3px; padding: 2px 4px;">
                            <option value="10">10</option>
                            <option value="20" selected>20</option>
                            <option value="50">50</option>
                            <option value="0" data-i18n="events.perPageAll">All</option>
                        </select>
                        <span data-i18n="events.items">items</span>
                    </span>
                    <input type="text" id="searchBox" class="form-control form-control-sm"
                           placeholder="Search event name..." data-i18n-placeholder="events.searchPlaceholder" style="width: 200px;" />
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table mb-0" id="eventTable" style="border-radius: 0;">
                        <thead style="background-color: #3d3d3f; color: #e0e0e0;">
                            <tr>
                                <th style="width: 50px; border-bottom: 1px solid #555; font-weight: 600; padding: 0.5rem 0.75rem; background-color: #3d3d3f; color: #e0e0e0;" data-i18n="events.colActive">Active</th>
                                <th style="border-bottom: 1px solid #555; font-weight: 600; padding: 0.5rem 0.75rem; background-color: #3d3d3f; color: #e0e0e0;" data-i18n="events.colName">Event Name</th>
                                <th style="width: 120px; border-bottom: 1px solid #555; font-weight: 600; padding: 0.5rem 0.75rem; background-color: #3d3d3f; color: #e0e0e0;" data-i18n="events.colBannerId">Banner ID</th>
                                <th style="width: 120px; border-bottom: 1px solid #555; font-weight: 600; padding: 0.5rem 0.75rem; background-color: #3d3d3f; color: #e0e0e0;" data-i18n="events.colEventId">Event ID</th>
                            </tr>
                        </thead>
                        <tbody id="eventTbody">
                            @foreach (var item in allBanners)
                            {
                                var isChecked = activeIds.Contains(item.Id);
                                var names = bannerNames[item.Id];
                                <tr class="event-row @(isChecked ? "row-active" : "")"
                                    data-id="@item.Id" data-name="@names.English"
                                    data-name-en="@names.English" data-name-zh="@names.Chinese"
                                    data-name-ja="@names.Japanese" data-name-ko="@names.Korean"
                                    data-search="@names.SearchText @item.Id @item.EventId @item.PrivateBannerResource"
                                    style="display: none;">
                                    <td class="text-center">
                                        <input type="checkbox" name="activeBannerIds" value="@item.Id"
                                               class="form-check-input event-checkbox"
                                               @(isChecked ? "checked" : "")
                                               style="transform: scale(1.2); cursor: pointer;" />
                                    </td>
                                    <td class="event-name">@names.English</td>
                                    <td>@item.Id</td>
                                    <td>@item.EventId</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            @* Pagination footer *@
            <div class="card-footer d-flex justify-content-between align-items-center py-2"
                 style="background: #2d2d2f; border-top: 1px solid #444;">
                <span id="pageInfo" style="color: #aaa; font-size: 0.85rem;"></span>
                <div class="d-flex gap-1" id="paginationControls"></div>
            </div>
        </div>
    </form>
</div>

<style>
    .row-active {
        background-color: rgba(56, 178, 121, 0.2) !important;
    }
    .row-active td {
        color: #e0e0e0 !important;
    }
    body {
        padding-bottom: 60px;
    }
</style>

@section Scripts {
    <script>
        // ---- Pagination state ----
        var allRows = [];
        var currentPage = 1;
        var pageSize = 20;
        var filteredRows = [];

        // ---- Collect all rows into JS array ----
        (function () {
            var tbody = document.getElementById('eventTbody');
            var rows = document.querySelectorAll('.event-row');
            rows.forEach(function (r) { tbody.appendChild(r); });
            allRows = Array.from(rows);
            filteredRows = allRows.slice();
            updateEventNames();
        })();

        // ---- Render current page ----
        function renderPage() {
            var tbody = document.getElementById('eventTbody');
            var total = filteredRows.length;
            var size = pageSize === 0 ? total : pageSize;
            var pages = size === 0 ? 1 : Math.max(1, Math.ceil(total / size));
            if (currentPage > pages) currentPage = pages;
            if (currentPage < 1) currentPage = 1;

            // Hide all, show only current page
            var start = (currentPage - 1) * size;
            var end = Math.min(start + size, total);
            allRows.forEach(function (row) { row.style.display = 'none'; });
            filteredRows.forEach(function (row, i) {
                row.style.display = (pageSize === 0 || (i >= start && i < end)) ? '' : 'none';
                // Make sure the row is in the tbody
                if (row.parentNode !== tbody) tbody.appendChild(row);
            });

            // Update page info
            var info = i18n.t('events.pageInfo', { total: total, pages: pages });
            if (pageSize > 0) {
                info += i18n.t('events.pageInfoCurrent', { page: currentPage, pages: pages });
            }
            document.getElementById('pageInfo').textContent = info;

            // Render pagination buttons
            renderPagination(pages);
        }

        // ---- Render pagination controls ----
        function renderPagination(pages) {
            var container = document.getElementById('paginationControls');
            container.innerHTML = '';

            if (pages <= 1 && pageSize !== 0) return;

            var prevBtn = document.createElement('button');
            prevBtn.type = 'button';
            prevBtn.className = 'btn btn-sm ' + (currentPage > 1 ? 'btn-outline-primary' : 'btn-outline-secondary disabled');
            prevBtn.textContent = '‹';
            prevBtn.onclick = function () { if (currentPage > 1) { currentPage--; renderPage(); } };
            container.appendChild(prevBtn);

            var maxButtons = 7;
            var half = Math.floor(maxButtons / 2);
            var startP = Math.max(1, currentPage - half);
            var endP = Math.min(pages, startP + maxButtons - 1);
            if (endP - startP < maxButtons - 1) startP = Math.max(1, endP - maxButtons + 1);

            for (var i = startP; i <= endP; i++) {
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'btn btn-sm ' + (i === currentPage ? 'btn-primary' : 'btn-outline-primary');
                btn.textContent = i;
                btn.onclick = (function (p) { return function () { currentPage = p; renderPage(); }; })(i);
                container.appendChild(btn);
            }

            var nextBtn = document.createElement('button');
            nextBtn.type = 'button';
            nextBtn.className = 'btn btn-sm ' + (currentPage < pages ? 'btn-outline-primary' : 'btn-outline-secondary disabled');
            nextBtn.textContent = '›';
            nextBtn.onclick = function () { if (currentPage < pages) { currentPage++; renderPage(); } };
            container.appendChild(nextBtn);
        }

        // ---- Page size change ----
        document.getElementById('pageSizeSelect').addEventListener('change', function () {
            pageSize = parseInt(this.value);
            currentPage = 1;
            applyFilter();
        });

        // ---- Search filter ----
        document.getElementById('searchBox').addEventListener('input', function () {
            currentPage = 1;
            applyFilter();
        });

        function applyFilter() {
            var q = document.getElementById('searchBox').value.toLowerCase().trim();
            filteredRows = allRows.filter(function (row) {
                var name = (row.dataset.search || '').toLowerCase();
                return !q || name.indexOf(q) !== -1;
            });
            renderPage();
        }

        // Search includes all translations and IDs; visible names follow the admin language.
        function updateEventNames() {
            var lang = i18n.currentLang;
            allRows.forEach(function (row) {
                var name = row.getAttribute('data-name-' + lang) || row.dataset.nameEn;
                row.dataset.name = name;
                row.querySelector('.event-name').textContent = name;
            });
            syncActiveTags();
            applyFilter();
        }
        window.addEventListener('adminui:languageChanged', updateEventNames);

        function syncActiveTags() {
            var container = document.getElementById('activeTags');
            container.replaceChildren();
            var selected = allRows.filter(function (row) { return row.querySelector('.event-checkbox').checked; });
            document.getElementById('activeCount').textContent = selected.length;
            document.getElementById('noEventsSelected').style.display = selected.length ? 'none' : '';
            selected.forEach(function (row) {
                var tag = document.createElement('span');
                tag.className = 'badge d-inline-flex align-items-center gap-1 active-tag';
                tag.dataset.id = row.dataset.id;
                tag.style.cssText = 'background-color: var(--adminui-success); font-size: 0.85rem; padding: 0.3rem 0.6rem;';
                var label = document.createElement('span');
                label.className = 'active-tag-name';
                label.textContent = row.dataset.name;
                var remove = document.createElement('i');
                remove.className = 'fas fa-times remove-tag';
                remove.dataset.id = row.dataset.id;
                remove.style.cssText = 'cursor: pointer; opacity: 0.7;';
                remove.addEventListener('click', removeTagHandler);
                tag.append(label, remove);
                container.appendChild(tag);
            });
        }

        function removeTagHandler() {
            var cb = document.querySelector('.event-checkbox[value="' + this.dataset.id + '"]');
            if (cb) {
                cb.checked = false;
                cb.dispatchEvent(new Event('change'));
            }
        }

        // ---- Click row to toggle checkbox ----
        document.querySelectorAll('.event-row td:not(:first-child)').forEach(function (td) {
            td.addEventListener('click', function () {
                var row = this.closest('.event-row');
                var cb = row.querySelector('.event-checkbox');
                if (cb) {
                    cb.checked = !cb.checked;
                    cb.dispatchEvent(new Event('change'));
                }
            });
        });

        // ---- Checkbox change sync ----
        document.querySelectorAll('.event-checkbox').forEach(function (cb) {
            cb.addEventListener('change', function () {
                var row = this.closest('.event-row');
                if (row) row.classList.toggle('row-active', this.checked);
                syncActiveTags();
            });
        });

        // ---- Success alert ----
        @if (TempData["MessageKey"] != null)
        {
        <text>
        document.addEventListener('DOMContentLoaded', function () {
            var alert = document.getElementById('saveAlert');
            alert.textContent = i18n.t('events.saved');
            alert.style.display = 'block';
            setTimeout(function () { alert.style.display = 'none'; }, 4000);
        });
        </text>
        }
    </script>
}
