@model EpinelPS.Models.Admin.ServerConfiguration

@{
    ViewData["Title"] = "Configuration";
}

<div class="text-center">
    <h1 class="display-4" data-i18n="config.server.title">Server Configuration</h1>
    <form asp-action="Configuration">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <dl class="row">
            <dt class="col-sm-2" data-i18n="config.server.logLevel">日志级别:</dt>
            <dd class="col-sm-10">
                @Html.DropDownListFor(model => model.LogType, Html.GetEnumSelectList<LogType>(), "", new { @class = "form-control" })
            </dd>
        </dl>
        <div class="form-group">
        <button id="reloadDB" type="button" class="btn btn-danger" data-i18n-title="config.server.updateResourcesHint" onclick="runSimpleCmd('update-server')" data-i18n="config.server.updateResources">Update resources</button>
            <button type="submit" class="btn btn-primary" data-i18n="common.save"></button>
        </div>
    </form>

    <form asp-action="SaveEffectChangeBands" method="post" class="mt-4 text-start">
        <fieldset>
            <legend>效果变更 · 词条数值档位</legend>
            <p>全服共用。每条重新抽取的词条先按概率选区间，再在区间内等概率选一档。三个区间连续覆盖第 1～15 档，概率合计须为 100%。</p>
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <label asp-for="EffectBands.LowEnd">低档上限</label>
                    <input asp-for="EffectBands.LowEnd" class="form-control" type="number" min="1" max="13" required />
                </div>
                <div class="col-sm-6">
                    <label asp-for="EffectBands.MiddleEnd">中档上限</label>
                    <input asp-for="EffectBands.MiddleEnd" class="form-control" type="number" min="2" max="14" required />
                </div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-sm-4">
                    <label asp-for="EffectBands.LowPercent">低档概率（%）</label>
                    <input asp-for="EffectBands.LowPercent" class="form-control" type="number" min="0" max="100" step="0.01" required />
                </div>
                <div class="col-sm-4">
                    <label asp-for="EffectBands.MiddlePercent">中档概率（%）</label>
                    <input asp-for="EffectBands.MiddlePercent" class="form-control" type="number" min="0" max="100" step="0.01" required />
                </div>
                <div class="col-sm-4">
                    <label asp-for="EffectBands.HighPercent">高档概率（%）</label>
                    <input asp-for="EffectBands.HighPercent" class="form-control" type="number" min="0" max="100" step="0.01" required />
                </div>
            </div>
            <button type="submit" class="btn btn-primary">保存档位设置</button>
            <button type="submit" name="restoreDefaults" value="true" formnovalidate class="btn btn-outline-secondary">恢复默认概率与分界</button>
            @if (TempData["EffectBandsSaved"] is string message) { <span role="status">@message</span> }
        </fieldset>
    </form>
</div>
